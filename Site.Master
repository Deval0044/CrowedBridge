<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CrowedBridge.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title>CrowdBridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-gray-50 font-sans text-gray-900">
    <form id="form1" runat="server">
        <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <a href="Default.aspx" class="text-2xl font-black tracking-tight text-gray-900">
                        Crowd<span class="text-orange-600">Bridge</span>
                    </a>

                    <div class="flex items-center gap-4">
                        <a href="Default.aspx" class="text-sm font-medium text-gray-700 hover:text-orange-600">Explore Projects</a>

                        <asp:PlaceHolder ID="phLoggedOut" runat="server">
                            <a href="Login.aspx" class="text-sm font-medium text-gray-700 hover:text-orange-600">Sign In</a>
                            <a href="Register.aspx" class="bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-sm">Register</a>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                            <asp:Label ID="lblUserGreeting" runat="server" CssClass="text-sm font-bold text-gray-800"></asp:Label>
                            <asp:HyperLink ID="hlAdminPortal" runat="server" NavigateUrl="~/Admin/AdminDashboard.aspx" Visible="false" CssClass="text-sm font-bold text-purple-600 border border-purple-200 px-3 py-1 rounded-md bg-purple-50">Admin Panel</asp:HyperLink>
                            <asp:Button ID="btnLogout" runat="server" Text="Sign Out" OnClick="btnLogout_Click" CssClass="text-sm font-medium text-red-600 hover:text-red-700 border border-red-200 px-3 py-1.5 rounded-lg cursor-pointer" CausesValidation="false" />
                        </asp:PlaceHolder>
                    </div>
                </div>
            </div>
        </nav>

        <div class="min-h-[80vh]">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500 mt-12">
            © 2026 CrowdBridge India. All rights reserved.
        </footer>
    </form>
</body>
</html>